# Anthropic — powers every text-generation agent (ideation, copy, hooks, analysis)
ANTHROPIC_API_KEY=

# Google Gemini — image generation for moodboard/concept-art visuals
GEMINI_API_KEY=

# Meta Graph API — from your Facebook Page + Instagram Business account
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=

# Telegram bot — this is your mobile approval channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Your GitHub repo, used to build public image URLs (owner/repo, e.g. soumya123/odia-ott-content-system)
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
