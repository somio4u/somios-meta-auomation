# Google Gemini via Vertex AI — powers every text-generation agent (ideation,
# copy, hooks, analysis) AND image generation for moodboard/concept-art visuals.
# GCP_SERVICE_ACCOUNT_KEY is the raw JSON key content for a service account
# with the "Vertex AI User" role, with the Vertex AI API enabled on the project.
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# Meta Graph API — from your Facebook Page + Instagram Business account
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=

# Telegram bot — this is your mobile approval channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# imgbb.com — free image hosting so Instagram's API can fetch a public image
# URL even though this repo is private (raw.githubusercontent.com URLs from a
# private repo aren't publicly fetchable)
IMGBB_API_KEY=
